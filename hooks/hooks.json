{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @tyroneross/bookmark restore 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @tyroneross/bookmark context-check 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @tyroneross/bookmark precompact 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @tyroneross/bookmark stop 2>/dev/null || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
